---
import { Icon } from 'astro-icon/components';
import { firma, navegacion, whatsappLink } from '../data/sitio';
import { servicios } from '../data/servicios';
---
<footer class="relative mt-16 overflow-hidden bg-navy text-white">
  <div class="pointer-events-none absolute -right-20 top-0 h-80 w-80 rounded-full bg-institu/25 blur-3xl" aria-hidden="true"></div>
  <div class="container-rp relative py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.25fr_1.2fr_.7fr_1fr]">
      <div>
        <a href="#inicio" class="inline-flex rounded-2xl bg-white px-4 py-3" aria-label={`${firma.nombre} — Inicio`}>
          <img src="/logotipo.png" alt={firma.nombre} width="280" height="76" class="h-9 w-auto" loading="lazy" />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/85">Experiencia que genera confianza.<br />Conocimiento que impulsa decisiones.</p>
        <p class="mt-4 text-sm text-white/80">Más de 40 años acompañando empresas.</p>
      </div>
      <div>
        <h2 class="text-base text-white">Servicios</h2>
        <ul class="mt-5 space-y-3 text-sm text-white/85">
          {servicios.map((servicio) => <li><a href={`#${servicio.slug}`} class="footer-link">{servicio.titulo}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-base text-white">Explore</h2>
        <ul class="mt-5 space-y-3 text-sm text-white/85">
          {navegacion.map((item) => <li><a href={item.href} class="footer-link">{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-base text-white">Conversemos</h2>
        <address class="mt-5 space-y-4 text-sm not-italic text-white/85">
          <p>{firma.contacto.direccionLinea1}<br />{firma.contacto.direccionLinea2}<br />{firma.contacto.ciudad}</p>
          <a href={firma.contacto.telefonoFijoHref} class="footer-link block">{firma.contacto.telefonoFijo}</a>
          <a href={whatsappLink} target="_blank" rel="noopener" class="footer-link flex items-center gap-2">
            <Icon name="ph:whatsapp-logo-fill" class="h-4 w-4" />{firma.contacto.whatsapp}
          </a>
          <a href={firma.contacto.emailHref} class="footer-link block break-all">{firma.contacto.email}</a>
        </address>
      </div>
    </div>
    <p class="mt-12 border-t border-white/20 pt-6 text-xs leading-relaxed text-white/80">© {new Date().getFullYear()} {firma.nombreCompleto}. Todos los derechos reservados.</p>
  </div>
</footer>
