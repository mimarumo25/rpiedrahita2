---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import oficinas from '../assets/oficinas-medellin.png';
import { whatsappLink } from '../data/sitio';
---

<section id="inicio" class="hero-section relative isolate flex items-center overflow-hidden">
  <Image src={oficinas} alt="" widths={[480, 768, 1120, 1600, 1931]} sizes="100vw"
    format="webp" quality={82} loading="eager" fetchpriority="high"
    class="hero-background absolute inset-0 -z-20 h-full w-full object-cover" />
  <div class="hero-shade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-rp relative py-32 text-center sm:pb-20 sm:pt-40">
    <div class="mx-auto max-w-5xl text-center">
      <h1 class="hero-title font-display font-extrabold text-white">
        <span class="block">Experiencia que genera <span class="word-mark mark-coral">confianza.</span></span>
        <span class="mt-3 block">Conocimiento que impulsa decisiones.</span>
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-fluid-base leading-relaxed text-white">
        Acompañamos a su empresa con independencia, rigor técnico y visión estratégica.
        Contabilidad, auditoría y gestión para decidir con confianza.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-coral">
          <Icon name="ph:whatsapp-logo-fill" class="h-5 w-5" />
          Conversemos sobre su empresa
        </a>
        <a href="#servicios" class="btn hero-secondary">
          Nuestros servicios <Icon name="ph:arrow-down-bold" class="h-4 w-4" />
        </a>
      </div>
    </div>
    <p class="mt-12 inline-flex items-center gap-3 rounded-full bg-navy/80 px-5 py-3 text-sm font-semibold text-white">
      <Icon name="ph:seal-check-fill" class="h-5 w-5 text-verde-est" />
      Más de 40 años de trayectoria
    </p>
  </div>
</section>
