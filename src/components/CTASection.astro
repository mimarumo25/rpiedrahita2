---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import conversacionEmpresarial from '../assets/conversacion-empresarial.jpg';
import { whatsappLink } from '../data/sitio';
---
<section class="container-rp section-space">
  <div class="contact-cta relative isolate flex min-h-[440px] items-end justify-center overflow-hidden rounded-5xl px-6 pb-10 pt-48 text-center sm:min-h-[520px] sm:px-12 sm:pb-14 sm:pt-60 lg:min-h-[560px] lg:pb-16 lg:pt-72">
    <Image
      src={conversacionEmpresarial}
      alt=""
      widths={[480, 768, 1120, 1408]}
      sizes="(max-width: 1280px) calc(100vw - 40px), 1200px"
      format="webp"
      quality={86}
      loading="lazy"
      class="cta-background absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="cta-shade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl">
      <h2 class="text-fluid-xl leading-tight text-white drop-shadow-md">Conversemos sobre el<br class="hidden sm:block" /> futuro de su empresa</h2>
      <p class="mx-auto mt-4 max-w-xl text-fluid-base leading-relaxed text-white drop-shadow">
        Cuéntenos qué necesita. Nuestro equipo está listo para escucharle y acompañar sus próximas decisiones.
      </p>
      <a href={whatsappLink} target="_blank" rel="noopener" class="btn mt-7 bg-white text-navy shadow-soft-lg hover:bg-gris-cl">
        <Icon name="ph:whatsapp-logo-fill" class="h-5 w-5 text-[#25D366]" /> Conversemos sobre su empresa
      </a>
    </div>
  </div>
</section>
