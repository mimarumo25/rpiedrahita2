---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import conversacionEmpresarial from '../assets/conversacion-empresarial.jpg';
import { firma, whatsappLink } from '../data/sitio';
---
<section class="container-rp section-space">
  <div class="contact-cta relative isolate overflow-hidden rounded-5xl bg-grad-institu shadow-soft-lg">
    <div class="pointer-events-none absolute -left-16 -top-16 -z-10 h-72 w-72 rounded-full bg-turquesa/30 blur-3xl animate-blob-drift" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-20 left-1/3 -z-10 h-72 w-72 rounded-full bg-coral/30 blur-3xl animate-blob-drift" style="animation-delay:-8s" aria-hidden="true"></div>
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <div class="flex flex-col justify-center px-6 py-12 sm:px-12 sm:py-16 lg:col-span-6 lg:py-20">
        <h2 class="text-fluid-xl leading-tight text-white">Conversemos sobre el<br class="hidden sm:block" /> <span class="word-mark mark-coral">futuro de su empresa</span></h2>
        <p class="mt-5 max-w-xl text-fluid-base leading-relaxed text-white/95">
          Cuéntenos qué necesita. Nuestro equipo está listo para escucharle y acompañar sus próximas decisiones.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={whatsappLink} target="_blank" rel="noopener" class="btn-coral">
            <Icon name="ph:whatsapp-logo-fill" class="h-5 w-5" /> Conversemos sobre su empresa
          </a>
          <a href={firma.contacto.emailHref} class="btn border border-white/35 bg-white/10 text-white backdrop-blur hover:bg-white/20">
            <Icon name="ph:envelope-simple-bold" class="h-5 w-5" /> {firma.contacto.email}
          </a>
        </div>
      </div>
      <div class="relative min-h-[280px] sm:min-h-[360px] lg:col-span-6 lg:min-h-[440px]">
        <Image
          src={conversacionEmpresarial}
          alt="Ejecutivos colombianos revisando proyecciones financieras en una oficina de Medellín"
          widths={[480, 768, 1120, 1408]}
          sizes="(max-width: 1023px) calc(100vw - 40px), 600px"
          format="webp"
          quality={86}
          loading="lazy"
          class="h-full w-full object-cover object-center lg:absolute lg:inset-0"
        />
      </div>
    </div>
  </div>
</section>
