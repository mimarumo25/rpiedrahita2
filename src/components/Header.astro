---
import { Icon } from 'astro-icon/components';
import { whatsappLink, firma, navegacion } from '../data/sitio';
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <div class="container-rp">
    <nav class="site-nav mt-3 flex items-center justify-between gap-3 rounded-2xl px-4 py-3 shadow-soft backdrop-blur-xl sm:px-6" aria-label="Navegación principal">
      <a href="#inicio" class="shrink-0" aria-label={`${firma.nombre} — Inicio`}>
        <img src="/logotipo.png" alt={firma.nombre} width="280" height="76" class="h-9 w-auto sm:h-10" decoding="async" />
      </a>
      <ul class="hidden items-center gap-5 lg:flex">
        {navegacion.map((item) => <li><a href={item.href} class="nav-link">{item.label}</a></li>)}
      </ul>
      <a href={whatsappLink} target="_blank" rel="noopener" class="btn-coral hidden px-5 py-2.5 lg:inline-flex">
        <Icon name="ph:whatsapp-logo-fill" class="h-4 w-4" /> Conversemos
      </a>
      <button id="mobile-toggle" hidden class="mobile-toggle h-11 w-11 items-center justify-center rounded-xl bg-institu/10 text-navy lg:!hidden"
        aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="ph:list-bold" class="h-6 w-6" />
      </button>
    </nav>
    <noscript>
      <nav aria-label="Navegación móvil" class="mt-2 flex flex-wrap justify-center gap-x-5 gap-y-2 rounded-2xl bg-white p-3 text-sm font-semibold text-navy lg:hidden">
        {navegacion.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </noscript>
  </div>
  <dialog id="mobile-menu" class="mobile-dialog fixed inset-x-3 top-3 m-0 w-auto max-w-none rounded-3xl bg-white p-6 text-navy shadow-soft-lg" aria-label="Menú de navegación">
    <div class="mb-4 flex items-center justify-between">
      <span class="font-display text-xl font-bold">Explore RPiedrahíta</span>
      <button id="mobile-close" class="flex h-11 w-11 items-center justify-center rounded-xl bg-gris-cl" aria-label="Cerrar menú">
        <Icon name="ph:x-bold" class="h-5 w-5" />
      </button>
    </div>
    <nav aria-label="Navegación móvil">
      <ul class="space-y-1">
        {navegacion.map((item) => <li><a href={item.href} class="block rounded-xl px-3 py-3 font-semibold hover:bg-institu/10" data-nav-link>{item.label}</a></li>)}
      </ul>
    </nav>
    <a href={whatsappLink} target="_blank" rel="noopener" class="btn-coral mt-5 w-full">Conversemos</a>
  </dialog>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#mobile-toggle');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const close = document.querySelector<HTMLButtonElement>('#mobile-close');
  if (toggle && menu && close) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    });
    const closeMenu = () => menu.close();
    close.addEventListener('click', closeMenu);
    menu.querySelectorAll('[data-nav-link]').forEach((link) => link.addEventListener('click', closeMenu));
    menu.addEventListener('click', (event) => {
      const box = menu.getBoundingClientRect();
      if (event.target === menu && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom)) closeMenu();
    });
    menu.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) closeMenu();
    });
  }
</script>
