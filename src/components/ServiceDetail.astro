---
import { Icon } from 'astro-icon/components';
import CTASection from './CTASection.astro';
import { firma } from '../data/sitio';
import { acentoHex, servicios, type Servicio } from '../data/servicios';

interface Props {
  servicio: Servicio;
}
const { servicio } = Astro.props;
const hex = acentoHex[servicio.acento];

// Servicios relacionados (excluyendo el actual)
const relacionados = servicios.filter((s) => s.slug !== servicio.slug).slice(0, 3);

const linkWhatsapp = `${firma.contacto.whatsappHref}?text=${encodeURIComponent(
  `Hola, quisiera un diagnóstico gratuito sobre el servicio de ${servicio.titulo}.`
)}`;
---

{/* ===== Hero del servicio ===== */}
<section class="relative overflow-hidden pt-32 pb-8 sm:pt-40 sm:pb-12">
  {/* Fondo con blobs del color de acento */}
  <div
    class="pointer-events-none absolute -left-24 top-16 h-80 w-80 rounded-full opacity-20 blur-3xl animate-blob-drift"
    style={`background:${hex}`}
    aria-hidden="true"
  ></div>
  <div class="pointer-events-none absolute -right-20 bottom-0 h-72 w-72 rounded-full bg-morado/15 blur-3xl animate-blob-drift" style="animation-delay:-8s" aria-hidden="true"></div>

  <div class="container-rp relative z-10">
    {/* Breadcrumb */}
    <nav class="mb-6 flex items-center gap-2 text-sm text-gris-ej" aria-label="Migas de pan">
      <a href="/" class="transition hover:text-institu">Inicio</a>
      <Icon name="ph:caret-right-bold" class="h-3.5 w-3.5" />
      <a href="/servicios" class="transition hover:text-institu">Servicios</a>
      <Icon name="ph:caret-right-bold" class="h-3.5 w-3.5" />
      <span class="font-semibold text-navy">{servicio.titulo}</span>
    </nav>

    <div class="grid items-center gap-10 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border bg-white/70 px-4 py-1.5 text-xs font-bold uppercase tracking-widest shadow-soft backdrop-blur animate-fade-up"
          style={`border-color:${hex}33; color:${hex}`}
        >
          <Icon name={servicio.icono} class="h-4 w-4" />
          Servicio especializado
        </span>

        <h1 class="mt-5 font-display text-fluid-2xl font-extrabold leading-[1.05] tracking-tight text-navy text-balance animate-fade-up" style="animation-delay:100ms">
          {servicio.hero.titulo}
        </h1>

        <p class="mt-5 max-w-xl text-fluid-base leading-relaxed text-gris-ej animate-fade-up" style="animation-delay:200ms">
          {servicio.hero.subtitulo}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row animate-fade-up" style="animation-delay:300ms">
          <a href={linkWhatsapp} target="_blank" rel="noopener" class="btn text-white text-base shadow-soft hover:-translate-y-0.5" style={`background:${hex}`}>
            <Icon name="ph:whatsapp-logo-fill" class="h-5 w-5" />
            Diagnóstico gratuito
          </a>
          <a href="/servicios" class="btn-ghost text-base">
            <Icon name="ph:arrow-left-bold" class="h-4 w-4" />
            Otros servicios
          </a>
        </div>
      </div>

      {/* Card visual del servicio */}
      <div class="relative" data-reveal="zoom">
        <div
          class="relative mx-auto flex aspect-square w-full max-w-sm flex-col items-center justify-center rounded-5xl p-10 text-center text-white shadow-soft-lg"
          style={`background: linear-gradient(135deg, ${hex}, ${hex}99)`}
        >
          <div class="pointer-events-none absolute inset-0 rounded-5xl bg-mesh-base opacity-30" aria-hidden="true"></div>
          <Icon name={servicio.icono} class="relative h-20 w-20 drop-shadow-lg animate-float-soft" />
          <p class="relative mt-5 font-display text-2xl font-extrabold">{servicio.titulo}</p>
          <p class="relative mt-2 text-sm text-white/85">RPiedrahíta Contadores Públicos</p>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ===== Acerca de + Objetivo ===== */}
<section class="relative py-8 sm:py-12">
  <div class="container-rp">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      {/* Acerca de */}
      <div data-reveal="up">
        <span class="eyebrow mb-4">
          <Icon name="ph:book-open-text-fill" class="h-4 w-4" />
          Acerca de este servicio
        </span>
        <h2 class="font-display text-fluid-lg font-extrabold text-navy">¿En qué consiste?</h2>
        <p class="mt-4 text-fluid-base leading-relaxed text-gris-ej">{servicio.acerca}</p>
      </div>

      {/* Objetivo principal */}
      <div class="relative overflow-hidden rounded-4xl p-8 text-white shadow-soft" style={`background: linear-gradient(135deg, ${hex}, ${hex}cc)`} data-reveal="up" data-reveal-delay="100">
        <div class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
        <Icon name="ph:target-fill" class="h-8 w-8" />
        <p class="mt-4 text-xs font-bold uppercase tracking-widest text-white/70">Objetivo principal</p>
        <p class="mt-2 font-display text-lg font-bold leading-snug">{servicio.objetivo}</p>
      </div>
    </div>
  </div>
</section>

{/* ===== ¿Qué hacemos? / Alcance ===== */}
<section class="relative py-8 sm:py-12">
  <div class="container-rp">
    <div class="text-center" data-reveal="up">
      <span class="eyebrow mb-4">
        <Icon name="ph:clipboard-text-fill" class="h-4 w-4" />
        ¿Qué hacemos?
      </span>
      <h2 class="font-display text-fluid-xl font-extrabold text-navy">Alcance de nuestro trabajo</h2>
      <p class="mx-auto mt-4 max-w-2xl text-fluid-base text-gris-ej">Todo lo que incluye este servicio, en detalle.</p>
    </div>

    <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
      {servicio.alcance.map((item, i) => (
        <li
          class="glass-card flex items-start gap-4 py-5"
          data-reveal="up"
          data-reveal-delay={(i % 2) * 100}
        >
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-white shadow-soft"
            style={`background:${hex}`}
          >
            <Icon name="ph:check-bold" class="h-5 w-5" />
          </span>
          <span class="text-sm font-medium text-navy">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ===== Beneficios comprobados ===== */}
<section class="relative py-8 sm:py-12">
  <div class="container-rp">
    <div class="text-center" data-reveal="up">
      <span class="eyebrow mb-4">
        <Icon name="ph:trophy-fill" class="h-4 w-4" />
        Beneficios comprobados
      </span>
      <h2 class="font-display text-fluid-xl font-extrabold text-navy">Lo que su empresa gana</h2>
      <p class="mx-auto mt-4 max-w-2xl text-fluid-base text-gris-ej">Resultados concretos que nuestros clientes han experimentado durante 40+ años.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {servicio.beneficios.map((b, i) => (
        <div
          class="prisma-hover glass-card group"
          data-reveal="up"
          data-reveal-delay={i * 80}
        >
          <span
            class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl text-white shadow-soft transition-transform duration-500 group-hover:scale-110"
            style={`background: linear-gradient(135deg, ${hex}, ${hex}99)`}
          >
            <Icon name={b.icono} class="h-7 w-7" />
          </span>
          <h3 class="font-display text-base font-bold text-navy">{b.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gris-ej">{b.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ===== ¿Para quién es este servicio? ===== */}
<section class="relative py-8 sm:py-12">
  <div class="container-rp">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div data-reveal="left">
        <span class="eyebrow mb-4">
          <Icon name="ph:users-three-fill" class="h-4 w-4" />
          ¿Para quién es?
        </span>
        <h2 class="font-display text-fluid-lg font-extrabold text-navy">¿Es este servicio para usted?</h2>
        <p class="mt-4 text-fluid-base leading-relaxed text-gris-ej">
          Este servicio está diseñado especialmente para empresas y organizaciones que se encuentran en alguna de estas situaciones:
        </p>
      </div>

      <ul class="space-y-3" data-reveal="right">
        {servicio.paraQuien.map((p) => (
          <li class="flex items-start gap-4 rounded-2xl border border-white/60 bg-white/70 p-5 shadow-soft backdrop-blur transition hover:shadow-soft-lg">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-white shadow-soft"
              style={`background:${hex}`}
            >
              <Icon name="ph:check-bold" class="h-5 w-5" />
            </span>
            <span class="text-sm font-medium text-navy">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

{/* ===== Servicios relacionados ===== */}
<section class="relative py-8 sm:py-12">
  <div class="container-rp">
    <div class="mb-10 text-center" data-reveal="up">
      <h2 class="font-display text-fluid-lg font-extrabold text-navy">Otros servicios que pueden interesarle</h2>
    </div>
    <div class="grid gap-6 sm:grid-cols-3">
      {relacionados.map((s, i) => {
        const rHex = acentoHex[s.acento];
        return (
          <a
            href={`/servicios/${s.slug}`}
            class="prisma-hover glass-card group flex items-center gap-4 py-5"
            data-reveal="up"
            data-reveal-delay={i * 100}
          >
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-white shadow-soft transition-transform group-hover:scale-110"
              style={`background: linear-gradient(135deg, ${rHex}, ${rHex}99)`}
            >
              <Icon name={s.icono} class="h-6 w-6" />
            </span>
            <span class="flex-1">
              <span class="block font-display text-base font-bold text-navy">{s.titulo}</span>
              <span class="block text-xs text-gris-ej">{s.tagline}</span>
            </span>
            <Icon name="ph:arrow-right-bold" class="h-5 w-5 text-gris-ej transition-transform group-hover:translate-x-1" style={`color:${rHex}`} />
          </a>
        );
      })}
    </div>
  </div>
</section>

{/* ===== CTA de diagnóstico gratuito ===== */}
<CTASection
  titulo="¿Le interesa este servicio?"
  subtitulo={`Solicite un diagnóstico gratuito de ${servicio.titulo.toLowerCase()}. Le diremos con honestidad si lo necesita y cómo podemos ayudarle.`}
  ctaPrimario="Solicitar diagnóstico gratis"
  ctaSecundario="Ver todos los servicios"
  ctaSecundarioHref="/servicios"
  variant="institu"
/>
