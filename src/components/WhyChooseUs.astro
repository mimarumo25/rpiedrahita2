---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

const razones = [
  {
    icono: 'ph:medal-fill',
    titulo: '40+ años de trayectoria',
    descripcion: 'Cuatro décadas de experiencia resistiendo crisis, reformas y cambios normativos. Eso no se improvisa.',
    color: '#0070C0',
  },
  {
    icono: 'ph:certificate-fill',
    titulo: 'Contadores Públicos titulados',
    descripcion: 'Equipo con tarjeta profesional vigente, inscritos ante la Junta Central de Contadores de Colombia.',
    color: '#6CB83F',
  },
  {
    icono: 'ph:x-circle-fill',
    titulo: 'Récord impecable',
    descripcion: 'Cero sanciones en nuestro historial. Trabajo pulcro, documentado y defendible ante cualquier ente.',
    color: '#E66C2C',
  },
  {
    icono: 'ph:handshake-fill',
    titulo: 'Cercanía real',
    descripcion: 'Hablamos su idioma, no el de los decretos. Le explicamos todo de forma clara y humana.',
    color: '#7030A0',
  },
  {
    icono: 'ph:cpu-fill',
    titulo: 'Tecnología de punta',
    descripcion: 'Software contable, análisis de datos y reportes en tiempo real. Modernidad sin perder el criterio.',
    color: '#00B0F0',
  },
  {
    icono: 'ph:timer-fill',
    titulo: 'Cumplimiento y oportunidad',
    descripcion: 'Fechas cumplidas, información a tiempo. La oportunidad es la mitad del valor de la información.',
    color: '#FFC000',
  },
];
---

<section class="relative py-8 sm:py-12">
  <div class="container-rp">
    <SectionHeading
      eyebrow="¿Por qué elegirnos?"
      eyebrowIcon="ph:trophy-fill"
      titulo="Más que contadores, su"
      tituloDestacado="aliado estratégico"
      descripcion="Elegir un aliado contable es una decisión de confianza. Estas son las razones por las que 500+ empresas descansan en nosotros."
    />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {razones.map((r, i) => (
        <div
          class="prisma-hover glass-card group"
          data-reveal="up"
          data-reveal-delay={(i % 3) * 100}
        >
          <span
            class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl text-white shadow-soft transition-all duration-500 group-hover:scale-110 group-hover:-rotate-3"
            style={`background: linear-gradient(135deg, ${r.color}, ${r.color}99)`}
          >
            <Icon name={r.icono} class="h-7 w-7" />
          </span>
          <h3 class="font-display text-lg font-bold text-navy">{r.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gris-ej">{r.descripcion}</p>
        </div>
      ))}
    </div>
  </div>
</section>
