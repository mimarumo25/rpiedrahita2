---
import SectionHeading from './SectionHeading.astro';
import { testimonios } from '../data/clientes';
import logoPrebel from '../assets/clientes/prebel.svg';
import logoUmo from '../assets/clientes/umo.png';
import logoFundacionOyeme from '../assets/clientes/fundacion-oyeme.png';
import logoMedicinaFetal from '../assets/clientes/medicina-fetal.svg';
import logoValoresSimesa from '../assets/clientes/valores-simesa.png';
import logoRtaDesign from '../assets/clientes/rta-design.png';

const logosPorTestimonio: Record<string, ImageMetadata> = {
  'Prebel BIC S.A.': logoPrebel,
  'UMO S.A.': logoUmo,
  'Fundación Óyeme': logoFundacionOyeme,
  'Medicina Fetal S.A.S.': logoMedicinaFetal,
  'Valores Simesa S.A.': logoValoresSimesa,
  'CI. RTA Design S.A.S.': logoRtaDesign,
};

const tones = [
  'testimonial-0',
  'testimonial-1',
  'testimonial-2',
  'testimonial-3',
  'testimonial-4',
  'testimonial-5',
];

const items = testimonios.map((testimonio, i) => ({
  ...testimonio,
  tone: tones[i % tones.length],
  logo: logosPorTestimonio[testimonio.empresa],
}));
---
<section id="testimonios" class="section-space">
  <div class="container-rp">
    <SectionHeading
      titulo="La mejor forma de conocernos:"
      tituloDestacado="escuchar a nuestros clientes."
      descripcion="Palabras compartidas con motivo de nuestros 40 años de constitución."
    />

    <div
      class="testimonials-grid mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      role="region"
      aria-label="Testimonios de clientes"
      data-reveal-stagger
    >
      {items.map((testimonio) => (
        <figure
          data-reveal
          class={`testimonial ${testimonio.tone} relative flex flex-col justify-between rounded-4xl p-7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-soft-lg sm:p-8`}
        >
          <div>
            <span class="quote-mark block font-display text-6xl leading-none" aria-hidden="true">“</span>
            <blockquote class="relative mt-2 text-base leading-relaxed text-navy">
              <p>{testimonio.cita}</p>
            </blockquote>
          </div>
          <figcaption class="mt-7 flex items-center justify-between gap-4 border-t border-navy/15 pt-5 text-navy">
            <div>
              <strong class="block font-display text-base">{testimonio.empresa}</strong>
              <span class="mt-1 block text-sm text-navy/85">{testimonio.cargo}</span>
              {testimonio.extracto && <span class="mt-2 block text-xs text-navy/70">Extracto del testimonio</span>}
            </div>
            {testimonio.logo && (
              <div class="flex h-14 w-32 shrink-0 items-center justify-center rounded-xl bg-white px-3 py-2 shadow-sm ring-1 ring-navy/5">
                <img
                  src={testimonio.logo.src}
                  width={testimonio.logo.width}
                  height={testimonio.logo.height}
                  alt={`Logotipo oficial de ${testimonio.empresa}`}
                  loading="lazy"
                  decoding="async"
                  class="h-10 max-h-10 w-auto max-w-[110px] object-contain"
                />
              </div>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
