---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

// Riesgos con su nivel semafórico (Tablero Vivo)
const riesgos = [
  {
    nivel: 'Crítico',
    color: '#C00000',
    icono: 'ph:warning-fill',
    titulo: 'Contingencias tributarias',
    descripcion: 'Errores en IVA, retención o renta que derivan en sanciones, intereses y embargos por parte de la DIAN.',
  },
  {
    nivel: 'Alto',
    color: '#FFC000',
    icono: 'ph:bug-beetle-fill',
    titulo: 'Fraude interno y mal manejo',
    descripcion: 'Falta de controles que permiten desvíos de recursos, pagos duplicados o manipulación de información.',
  },
  {
    nivel: 'Alto',
    color: '#FFC000',
    icono: 'ph:gavel-fill',
    titulo: 'Demandas laborales',
    descripcion: 'Liquidaciones erróneas de nómina o prestaciones que terminan en demandas y fallos costosos.',
  },
  {
    nivel: 'Crítico',
    color: '#C00000',
    icono: 'ph:file-x-fill',
    titulo: 'Estados financieros no confiables',
    descripcion: 'Información desactualizada o errónea que impide decidir y destruye la confianza de socios y bancos.',
  },
  {
    nivel: 'Medio',
    color: '#00B0F0',
    icono: 'ph:video-camera-fill',
    titulo: 'Controles internos débiles',
    descripcion: 'Procesos sin documentación ni segregación de funciones que abren la puerta al error y al fraude.',
  },
  {
    nivel: 'Crítico',
    color: '#C00000',
    icono: 'ph:bank-fill',
    titulo: 'Incumplimiento societario',
    descripcion: 'Falta de revisor fiscal o de asambleas que generan inhabilidades y problemas ante la Cámara de Comercio.',
  },
];
---

<section id="riesgos" class="relative py-8 sm:py-12">
  <div class="container-rp">
    <SectionHeading
      eyebrow="Riesgos que enfrenta"
      eyebrowIcon="ph:warning-fill"
      titulo="¿Sabía que su empresa está expuesta a"
      tituloDestacado="riesgos silenciosos?"
      descripcion="Muchas empresas colombianas conviven con riesgos contables, fiscales y laborales sin saberlo. La buena noticia: todos se previenen con el acompañamiento adecuado."
    />

    {/* Leyenda del semáforo */}
    <div class="mt-10 flex flex-wrap items-center justify-center gap-5" data-reveal="up">
      <span class="flex items-center gap-2 text-sm font-semibold text-gris-ej">
        <span class="h-3 w-3 rounded-full bg-rojo-riesgo shadow-[0_0_12px_#C00000]"></span> Crítico
      </span>
      <span class="flex items-center gap-2 text-sm font-semibold text-gris-ej">
        <span class="h-3 w-3 rounded-full bg-ambar-riesgo shadow-[0_0_12px_#FFC000]"></span> Alto
      </span>
      <span class="flex items-center gap-2 text-sm font-semibold text-gris-ej">
        <span class="h-3 w-3 rounded-full bg-turquesa shadow-[0_0_12px_#00B0F0]"></span> Medio
      </span>
    </div>

    {/* Grid de riesgos */}
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {riesgos.map((r, i) => (
        <article
          class="prisma-hover glass-card group relative"
          data-reveal="up"
          data-reveal-delay={i * 80}
        >
          {/* Indicador de nivel (punto pulsante) */}
          <div class="absolute right-5 top-5 flex items-center gap-2">
            <span class="relative flex h-3 w-3">
              <span
                class="absolute inline-flex h-full w-full rounded-full opacity-75 animate-pulse-ring"
                style={`background:${r.color}`}
              ></span>
              <span class="relative inline-flex h-3 w-3 rounded-full" style={`background:${r.color}`}></span>
            </span>
            <span class="text-[0.65rem] font-bold uppercase tracking-widest" style={`color:${r.color}`}>
              {r.nivel}
            </span>
          </div>

          <span
            class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl text-white shadow-soft transition-transform duration-500 group-hover:scale-110"
            style={`background: linear-gradient(135deg, ${r.color}, ${r.color}aa)`}
          >
            <Icon name={r.icono} class="h-6 w-6" />
          </span>

          <h3 class="font-display text-lg font-bold text-navy">{r.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gris-ej">{r.descripcion}</p>
        </article>
      ))}
    </div>

    {/* Mensaje de cierre */}
    <div class="mx-auto mt-12 max-w-2xl rounded-3xl border border-verde-est/20 bg-verde-est/5 p-6 text-center" data-reveal="up">
      <p class="flex flex-wrap items-center justify-center gap-2 text-fluid-base font-semibold text-navy">
        <Icon name="ph:shield-check-fill" class="h-6 w-6 text-verde-est" />
        Todos estos riesgos se previenen con un aliado contable experto.
      </p>
    </div>
  </div>
</section>
