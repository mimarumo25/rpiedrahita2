---
import { Icon } from 'astro-icon/components';
import type { Servicio } from '../data/servicios';

interface Props { servicio: Servicio; }
const { servicio } = Astro.props;
---
<article id={servicio.slug} class="service-card relative flex flex-col overflow-hidden rounded-3xl border border-white/80 p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg sm:p-8"
  style={`--acento: ${servicio.acento}`}>
  <span class="service-icon mb-6 flex h-13 w-13 items-center justify-center rounded-2xl text-white shadow-soft" aria-hidden="true">
    <Icon name={servicio.icono} class="h-6 w-6" />
  </span>
  <h3 class="font-display text-xl font-bold leading-snug text-navy">{servicio.titulo}</h3>
  <p class="mt-4 text-base leading-relaxed text-navy/80">{servicio.resumen}</p>
</article>
