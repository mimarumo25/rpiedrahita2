---
import { Icon } from 'astro-icon/components';
import type { Servicio } from '../data/servicios';

interface Props { servicio: Servicio; }
const { servicio } = Astro.props;
---
<article id={servicio.slug} class="service-card relative flex flex-col overflow-hidden rounded-3xl p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg sm:p-8"
  style={`--acento: ${servicio.acento}`}>
  <span class="service-icon mb-6 flex h-14 w-14 items-center justify-center rounded-2xl shadow-soft" style={`color: ${['#0070C0', '#7030A0', '#E66C2C'].includes(servicio.acento) ? '#fff' : '#002D56'}`} aria-hidden="true">
    <Icon name={servicio.icono} class="h-7 w-7" />
  </span>
  <h3 class="font-display text-xl font-bold leading-snug text-navy">{servicio.titulo}</h3>
  <p class="mt-4 text-base leading-relaxed text-navy/80">{servicio.resumen}</p>
</article>
