---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { whatsappLink } from '../data/sitio';

interface Props {
  eyebrow?: string;
  titulo?: string;
  tituloDestacado?: string;
  descripcion?: string;
}
const {
  eyebrow = 'Nuestro proceso',
  titulo = 'Trabajar con nosotros es',
  tituloDestacado = 'simple y transparente',
  descripcion = 'Un proceso claro en cuatro pasos, desde el primer contacto hasta el acompañamiento permanente.',
} = Astro.props;

const pasos = [
  {
    n: '1',
    titulo: 'Conversemos',
    descripcion: 'Una primera charla sin costo donde nos cuenta su empresa, sus inquietudes y sus metas.',
    icono: 'ph:chat-circle-text-fill',
    color: '#0070C0',
  },
  {
    n: '2',
    titulo: 'Diagnosticamos',
    descripcion: 'Revisamos su situación contable, fiscal y de control. Le entregamos un diagnóstico claro y honesto.',
    icono: 'ph:stethoscope-fill',
    color: '#00B0F0',
  },
  {
    n: '3',
    titulo: 'Proponemos',
    descripcion: 'Diseñamos un plan de servicios a la medida con alcance, tiempos y valor transparente. Sin sorpresas.',
    icono: 'ph:file-text-fill',
    color: '#6CB83F',
  },
  {
    n: '4',
    titulo: 'Acompañamos',
    descripcion: 'Ejecutamos con criterio y lo acompañamos en el día a día. Estamos siempre a un mensaje de distancia.',
    icono: 'ph:heart-fill',
    color: '#E66C2C',
  },
];
---

<section class="relative overflow-hidden py-8 sm:py-12">
  {/* Fondo institucional suave */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-gris-cl/40 via-transparent to-gris-cl/40" aria-hidden="true"></div>

  <div class="container-rp">
    <SectionHeading
      eyebrow={eyebrow}
      eyebrowIcon="ph:path-fill"
      titulo={titulo}
      tituloDestacado={tituloDestacado}
      descripcion={descripcion}
    />

    {/* Pasos verticales conectados */}
    <div class="mx-auto mt-14 max-w-3xl">
      <div class="relative">
        {/* Línea vertical conectora */}
        <div class="absolute left-[1.55rem] top-4 bottom-4 w-0.5 bg-gradient-to-b from-institu via-verde-est to-coral sm:left-6" aria-hidden="true"></div>

        <ol class="space-y-8">
          {pasos.map((p, i) => (
            <li class="relative flex gap-5 sm:gap-7" data-reveal="left" data-reveal-delay={i * 100}>
              <span
                class="relative z-10 flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl font-display text-lg font-extrabold text-white shadow-soft sm:h-12 sm:w-12"
                style={`background: linear-gradient(135deg, ${p.color}, ${p.color}aa); min-width: 3.25rem; min-height: 3.25rem;`}
              >
                {p.n}
              </span>
              <div class="glass-card flex-1 pt-5 pb-5">
                <div class="flex items-center gap-3">
                  <Icon name={p.icono} class="h-6 w-6" style={`color:${p.color}`} />
                  <h3 class="font-display text-lg font-bold text-navy">{p.titulo}</h3>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-gris-ej">{p.descripcion}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-10 text-center" data-reveal="up">
        <a href={whatsappLink} target="_blank" rel="noopener" class="btn-coral text-base">
          <Icon name="ph:whatsapp-logo-fill" class="h-5 w-5" />
          Empecemos hoy
        </a>
      </div>
    </div>
  </div>
</section>
