---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import oficinas from '../assets/oficinas-medellin.png';
import { firma } from '../data/sitio';
import BackgroundFX from '../components/BackgroundFX.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MotionControl from '../components/MotionControl.astro';

const title = 'RPiedrahíta | Auditoría, Contabilidad y Confianza en Medellín';
const description = 'Más de 40 años de trayectoria profesional. Revisoría fiscal, auditoría, outsourcing contable, gestión tributaria y BPO de nómina con independencia y rigor técnico.';
const canonical = new URL('/', Astro.site).toString();
const socialImage = await getImage({ src: oficinas, width: 1200, format: 'jpg', quality: 82 });
const imageUrl = new URL(socialImage.src, Astro.site).toString();
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={firma.nombreCompleto} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Imagen de referencia empresarial en Medellín al atardecer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'AccountingService',
      name: firma.nombreCompleto,
      description,
      url: canonical,
      image: imageUrl,
      telephone: firma.contacto.telefonoFijo,
      email: firma.contacto.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${firma.contacto.direccionLinea2}, ${firma.contacto.direccionLinea1}`,
        addressLocality: 'Medellín',
        addressCountry: 'CO',
      },
      areaServed: 'Colombia',
    })} />
  </head>
  <body class="relative min-h-screen">
    <a href="#contenido" class="skip-link">Ir al contenido</a>
    <BackgroundFX />
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header />
      <main id="contenido" class="flex-1" tabindex="-1"><slot /></main>
      <Footer />
    </div>
    <MotionControl />
    <WhatsAppFloat />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
