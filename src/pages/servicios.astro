---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout
  activeNav="servicios"
  title="Servicios | Revisoría Fiscal, Auditoría y Outsourcing | RPiedrahíta"
  description="Conozca nuestros 6 servicios especializados: revisoría fiscal, auditoría interna y externa, outsourcing contable, outsourcing de control interno y liquidación de nómina en Medellín."
>
  {/* Hero */}
  <PageHero
    eyebrow="Nuestros servicios"
    eyebrowIcon="ph:briefcase-fill"
    titulo="Contaduría que"
    tituloDestacado="protege su empresa y potencia sus decisiones"
    descripcion="Un portafolio completo de servicios de contaduría pública diseñado para proteger su patrimonio, garantizar el cumplimiento normativo y darles tranquilidad a usted y a sus socios."
    acento="#0070C0"
  />

  {/* Grid de servicios */}
  <ServicesGrid showHeading={false} showCta={false} />

  {/* ¿Por qué elegirnos? */}
  <WhyChooseUs />

  {/* Nuestro proceso */}
  <ProcessSteps />

  {/* CTA */}
  <CTASection
    titulo="¿Necesita asesoría especializada?"
    subtitulo="Cuéntenos sobre su empresa y le diremos con honestidad qué servicio necesita y cuál no. La primera conversación es gratis y sin compromiso."
    ctaPrimario="Agende su consulta gratis"
    ctaSecundario="Ver todos los servicios"
    ctaSecundarioHref="/servicios"
    variant="coral"
  />
</BaseLayout>
