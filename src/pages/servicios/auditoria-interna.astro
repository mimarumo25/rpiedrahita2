---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { getServicio } from '../../data/servicios';

const servicio = getServicio('auditoria-interna')!;
---

<BaseLayout
  activeNav="servicios"
  title="Auditoría Interna en Medellín | RPiedrahíta Contadores Públicos"
  description="Servicio de auditoría interna para fortalecer su operación: evaluación de controles, gestión de riesgos, prevención de fraude y mejora de procesos. 40+ años de experiencia."
>
  <ServiceDetail servicio={servicio} />
</BaseLayout>
